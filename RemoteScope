-- Check whether an instance belongs to Roblox's own core / built-in modules
local function isRobloxInstance(child)
    if child:IsDescendantOf(CoreGui) then
        return true
    end

    local corePackages = game:FindService("CorePackages")
    if corePackages and child:IsDescendantOf(corePackages) then
        return true
    end

    local fullName = child:GetFullName()
    if string.find(fullName, "RobloxGui", 1, true)
        or string.find(fullName, "CoreGui", 1, true)
        or string.find(fullName, "CorePackages", 1, true) then
        return true
    end

    return false
end

-- Try every available method to retrieve a script's source
local function tryGetSource(child)
    local source = nil

    -- 1) .Source property (works for some LocalScripts)
    local propertyOk1, propertySource = pcall(function() return child.Source end)
    if propertyOk1 and propertySource and #propertySource > 0 then
        source = propertySource
    end

    -- 2) Executor's global decompile function
    if not source and type(decompile) == "function" then
        local decompileOk, decompiledSource = pcall(decompile, child)
        if decompileOk and type(decompiledSource) == "string" and #decompiledSource > 0 then
            source = decompiledSource
        end
    end

    -- 3) Bytecode disassembly fallback
    if not source and type(getscriptbytecode) == "function" then
        local bytecodeOk, bytecode = pcall(getscriptbytecode, child)
        if bytecodeOk and bytecode and type(disassemble) == "function" then
            local disassembleOk, disassembled = pcall(disassemble, bytecode)
            if disassembleOk and type(disassembled) == "string" and #disassembled > 0 then
                source = "-- [Bytecode Disassembly]\n" .. disassembled
            end
        end
    end

    return source
end

-- Build a short info block for non-source instances (Sound, Animation, Remotes, etc.)
local function getInstanceInfo(child)
    local lines = {
        "-- Instance: " .. child:GetFullName(),
        "-- Type: " .. child.ClassName,
    }

    if child.ClassName == "Sound" then
        local propertyOk2, soundId = pcall(function() return child.SoundId end)
        table.insert(lines, "-- SoundId: " .. (propertyOk2 and tostring(soundId) or "N/A"))
    elseif child.ClassName == "Animation" then
        local propertyOk3, animationId = pcall(function() return child.AnimationId end)
        table.insert(lines, "-- AnimationId: " .. (propertyOk3 and tostring(animationId) or "N/A"))
    end

    return table.concat(lines, "\n")
end

-- Scan a script's source for FireServer / InvokeServer remote calls,
-- capturing the actual call code (e.g. Remote:FireServer("Action", 1))
local function scanRemotes(source, scriptName, remoteStats)
    for rawLine in source:gmatch("[^\r\n]+") do
        local line = rawLine:match("^%s*(.-)%s*$") -- trim

        if line:find(":%s*FireServer%s*%(") then
            remoteStats.fireServer += 1
            table.insert(remoteStats.calls, {
                type = "FireServer",
                code = line,
                source = scriptName,
            })
        end

        if line:find(":%s*InvokeServer%s*%(") then
            remoteStats.invokeServer += 1
            table.insert(remoteStats.calls, {
                type = "InvokeServer",
                code = line,
                source = scriptName,
            })
        end
    end
end


