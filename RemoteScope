        setStatus("Scanning game for scripts...", Theme.TextSecondary)

        local includeModules = decompilationData.includeModules
        decompilationData.isRunning = true

        task.spawn(function()
            local processed = {}
            local scriptInstances = {}
            local moduleInstances = {}

            -- 1) Enumerate (each instance only ever added once -> no duplicates)
            local function enumerate(instance)
                if not decompilationData.isRunning then return end

                local childrenOk, children = pcall(instance.GetChildren, instance)
                if not childrenOk then return end

                for _, child in ipairs(children) do
                    if not decompilationData.isRunning then return end

                    if not processed[child] and not isRobloxInstance(child) then
                        if child:IsA("LocalScript") or child:IsA("Script") then
                            processed[child] = true
                            table.insert(scriptInstances, child)
                        elseif includeModules and MODULE_CLASSES[child.ClassName] then
                            processed[child] = true
                            table.insert(moduleInstances, child)
                        end
                    end

                    enumerate(child)
                end
            end

            enumerate(game)

            decompilationData.totalCount = #scriptInstances + #moduleInstances

            if decompilationData.totalCount == 0 then
                decompilationData.isRunning = false
                setStatus("No eligible scripts found", Theme.Warning)
                NotificationUI:CreateNotification("Decompiler", "No scripts found to decompile", 2)
                return
            end

            updateProgress()
            NotificationUI:CreateNotification("Decompiler",
                "Found " .. #scriptInstances .. " script(s)"
                .. (includeModules and (" + " .. #moduleInstances .. " module(s)") or "")
                .. ". Decompiling...", 2)

            local successList, failList, moduleList = {}, {}, {}
            local remoteStats = {fireServer = 0, invokeServer = 0, calls = {}}

            -- 2) Decompile scripts
            for _, child in ipairs(scriptInstances) do
                if not decompilationData.isRunning then break end

                local source1 = tryGetSource(child)
                local header1 = "-- Script: " .. child:GetFullName()
                    .. "\n-- Type: " .. child.ClassName
                    .. "\n-- Path: " .. child:GetFullName() .. "\n"

                if source1 then
                    scanRemotes(source1, child:GetFullName(), remoteStats)
                    table.insert(successList, header1 .. "\n" .. source1)
                    print("[Decompiler] OK (" .. (decompilationData.completedCount + 1) .. "/"
                        .. decompilationData.totalCount .. ") " .. child:GetFullName())
                else
                    table.insert(failList, header1 .. "\n-- [Failed to decompile - source unavailable]")
                    print("[Decompiler] FAIL (" .. (decompilationData.completedCount + 1) .. "/"
                        .. decompilationData.totalCount .. ") " .. child:GetFullName() .. " - FAILED")
                end

                decompilationData.completedCount += 1
                updateProgress()
                setStatus("Decompiling: " .. child.Name
                    .. " (" .. decompilationData.completedCount .. "/" .. decompilationData.totalCount .. ")",
                    Theme.TextSecondary)

                task.wait()
            end

            -- 3) Process non-script modules (placed at the very end of the output)
            if includeModules and decompilationData.isRunning then
                for _, child in ipairs(moduleInstances) do
                    if not decompilationData.isRunning then break end

                    local entry
                    if child:IsA("ModuleScript") then
                        local source2 = tryGetSource(child)
                        local header2 = "-- Module: " .. child:GetFullName()
                            .. "\n-- Type: " .. child.ClassName
                            .. "\n-- Path: " .. child:GetFullName() .. "\n"

                        if source2 then
                            scanRemotes(source2, child:GetFullName(), remoteStats)
                            entry = header2 .. "\n" .. source2
                            print("[Decompiler] OK (" .. (decompilationData.completedCount + 1) .. "/"
                                .. decompilationData.totalCount .. ") " .. child:GetFullName())
                        else
                            entry = header2 .. "\n-- [Failed to decompile - source unavailable]"
                            print("[Decompiler] FAIL (" .. (decompilationData.completedCount + 1) .. "/"
                                .. decompilationData.totalCount .. ") " .. child:GetFullName() .. " - FAILED")
                        end
                    else
                        entry = getInstanceInfo(child)
                        print("[Decompiler] - (" .. (decompilationData.completedCount + 1) .. "/"
                            .. decompilationData.totalCount .. ") " .. child:GetFullName())
                    end

                    table.insert(moduleList, entry)
                    decompilationData.completedCount += 1
                    updateProgress()
                    setStatus("Scanning module: " .. child.Name
                        .. " (" .. decompilationData.completedCount .. "/" .. decompilationData.totalCount .. ")",
                        Theme.TextSecondary)

                    task.wait()
                end
            end

            -- 4) Build the final ordered output
            local output = {}

            -- Summary header (success/fail counts)
            local summaryLines = {
                "=== DECOMPILATION SUMMARY ===",
                "Total Scripts Found: " .. #scriptInstances,
                "Successful: " .. #successList,
                "Failed: " .. #failList,
            }
            if includeModules then
                table.insert(summaryLines, "Non-Script Modules Found: " .. #moduleInstances)
            end
            table.insert(output, table.concat(summaryLines, "\n"))

            -- Remote call summary (FireServer / InvokeServer)
            local remoteLines = {
                "=== REMOTE CALLS DETECTED ===",
                "FireServer calls: " .. remoteStats.fireServer,
                "InvokeServer calls: " .. remoteStats.invokeServer,
            }
            if #remoteStats.calls > 0 then
                table.insert(remoteLines, "")
                table.insert(remoteLines, "Remote Calls:")
                for _, call in ipairs(remoteStats.calls) do
                    table.insert(remoteLines, "  [" .. call.type .. "] (" .. call.source .. ")")
                    table.insert(remoteLines, "    " .. call.code)
                end
            else
                table.insert(remoteLines, "")
                table.insert(remoteLines, "No remote calls detected.")
            end
            table.insert(output, table.concat(remoteLines, "\n"))

            -- Successful scripts
            for _, entry in ipairs(successList) do
                table.insert(output, entry)
            end

            -- Failed scripts (all grouped together at the bottom)
            if #failList > 0 then
                table.insert(output, "=== FAILED TO DECOMPILE (" .. #failList .. ") ===")
                for _, entry in ipairs(failList) do
                    table.insert(output, entry)
                end
            end

            -- Non-script modules (very end of output)
            if includeModules and #moduleList > 0 then
                table.insert(output, "=== NON-SCRIPT MODULES (Sounds, Animations, Remotes, ModuleScripts, etc.) ===")
                for _, entry in ipairs(moduleList) do
                    table.insert(output, entry)
                end
            end

            decompilationData.scripts = output

            if decompilationData.isRunning then
                decompilationData.isRunning = false
                setStatus("Done! " .. #successList .. " ok, " .. #failList .. " failed"
                    .. (includeModules and (", " .. #moduleList .. " modules") or ""), Theme.Success)
                NotificationUI:CreateNotification("Decompiler",
                    "Finished - " .. #successList .. " success, " .. #failList .. " failed"
                    .. (includeModules and (", " .. #moduleList .. " modules") or ""), 3)
            else
                decompilationData.isRunning = false
            end
        end)
    end)

    return screenGui2
end

